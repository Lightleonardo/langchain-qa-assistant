# OpenAI (default). Copy this file to .env, then replace the placeholder with
# your real key. Leave OPENAI_BASE_URL unset for the OpenAI API.
OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=   (unset = https://api.openai.com/v1)

# OpenRouter (optional third-party gateway). Uncomment and adjust these lines
# to route through OpenRouter instead of the OpenAI API.
# OPENAI_API_KEY=sk-or-v1-your-openrouter-key
# OpenRouter may want a provider prefix on the model name, e.g.
# openai/gpt-5-mini rather than gpt-5-mini (this prefix is reported by
# third-party docs; I could not confirm it from OpenRouter's own docs).
# OPENAI_MODEL=openai/gpt-5-mini
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
